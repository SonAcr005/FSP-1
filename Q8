import pandas as pd
from sklearn.preprocessing import StandardScaler
df = pd.DataFrame({
    'Age': [18, 22, 25, 30, 35],
    'Salary': [20000, 25000, 30000, 40000, 50000]
})
scaler = StandardScaler()

scaled_data = scaler.fit_transform(df)

scaled_df = pd.DataFrame(scaled_data, columns=df.columns)

print("Original Data:")
print(df)

print("\nScaled Data:")
print(scaled_df)
