import numpy as np
data = [10, 12, 14, 15, 18, 20, 100]
mean = np.mean(data)
std = np.std(data)
z_scores = [(x - mean) / std for x in data]
outliers = [data[i] for i in range(len(data)) if abs(z_scores[i]) > 3]
print("Data:", data)
print("Mean:", mean)
print("Standard Deviation:", std)
print("Z-Scores:", z_scores)
print("Outliers:", outliers)
